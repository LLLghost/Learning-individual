[Unit]
Description=Mayak laboratory authoritative test-name resolver
After=network-online.target
Wants=network-online.target
[Service]
User=mayak-dns
Group=mayak-dns
RuntimeDirectory=mayak-dns
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/mayak-infrastructure/dnsmasq.conf
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target

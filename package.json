{
  "name": "server-infrastructure-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "episode": "node episodes/first-service/server.mjs",
    "episode:check": "node scripts/check-episode.mjs",
    "assemble": "node scripts/assemble-course.mjs",
    "build": "node scripts/build-static.mjs",
    "validate": "node scripts/validate-site.mjs",
    "validate:release": "npm run build && npm run validate && node scripts/check-coverage.mjs --strict && node scripts/smoke-browser.mjs && npm run verify:live",
    "verify:live": "node scripts/verify-live-reports.mjs"
  }
}
